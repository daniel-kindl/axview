<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>axview</AssemblyName>
    <RootNamespace>AxView</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AxView.Tests" />
  </ItemGroup>

  <!-- The picker UI. Its Avalonia version is independent of the target app's version. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <!-- The host runs inside the target app's runtime. Build it, but do not reference it. -->
  <ItemGroup>
    <ProjectReference Include="..\AxView.Host\AxView.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyHost" AfterTargets="Build">
    <MSBuild Projects="..\AxView.Host\AxView.Host.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="HostAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(HostAssembly);@(HostAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" DestinationFolder="$(OutDir)host" SkipUnchangedFiles="true" />
  </Target>

</Project>
