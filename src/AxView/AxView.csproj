<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>axview</AssemblyName>
    <RootNamespace>AxView</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AxView.Tests" />
  </ItemGroup>

  <!-- The host protocol. The launcher and the host both compile this source. See docs/adr/0001. -->
  <ItemGroup>
    <Compile Include="..\Protocol\*.cs" Link="Protocol\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The picker UI. Its Avalonia version is independent of the target app's version. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <!--
    The host runs inside the target app's runtime. Build it, but do not reference it.
    Each host build goes to its HostFolder next to the launcher. DotnetHostProcess selects the folder.
    Private="false" keeps the host deps and runtimeconfig files out of the launcher output.
    Both host builds have the same file names. The host runs with the deps and runtimeconfig of the target app.
  -->
  <ItemGroup>
    <HostProject Include="..\AxView.Host\AxView.Host.csproj" HostFolder="host" />
    <HostProject Include="..\AxView.Host12\AxView.Host12.csproj" HostFolder="host12" />
    <ProjectReference Include="@(HostProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyHost" AfterTargets="Build">
    <MSBuild Projects="@(HostProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="HostAssembly" />
    </MSBuild>
    <ItemGroup>
      <HostFile Include="@(HostAssembly);@(HostAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(HostFile)" DestinationFiles="@(HostFile->'$(OutDir)%(HostFolder)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishHost" AfterTargets="Publish" DependsOnTargets="CopyHost">
    <Copy SourceFiles="@(HostFile)" DestinationFiles="@(HostFile->'$(PublishDir)%(HostFolder)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
