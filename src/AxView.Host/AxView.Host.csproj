<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The host runs inside the target app's runtime (dotnet exec with the target's deps.json).
    net8.0 is the lowest runtime it supports. Avalonia references are compile-only:
    the target supplies Avalonia, and the launcher supplies the matching XAML loader.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AxView.Tests" />
  </ItemGroup>

  <!-- The host protocol. The launcher and the host both compile this source. See docs/adr/0001. -->
  <ItemGroup>
    <Compile Include="..\Protocol\*.cs" Link="Protocol\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" VersionOverride="11.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Desktop" VersionOverride="11.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" VersionOverride="11.0.0" ExcludeAssets="runtime" />
    <!-- Avalonia 11.0.0 brings older copies. These pins keep the same compile-only closure on the patched versions. -->
    <PackageReference Include="SkiaSharp" ExcludeAssets="runtime" />
    <PackageReference Include="Tmds.DBus.Protocol" VersionOverride="0.21.3" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
