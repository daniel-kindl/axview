<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The host runs inside the target app's runtime (dotnet exec with the target's deps.json).
    net8.0 is the lowest runtime it supports. Avalonia references are compile-only:
    the target supplies Avalonia, and the launcher supplies the matching XAML loader.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AxView.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
