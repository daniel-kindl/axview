<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 builds each test project as an executable. -->
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Avalonia.Headless.XUnit 12 needs xunit v3 3.2. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- The host tests render real AXAML on the headless platform. Only the tests use these packages, never the host. -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- The chrome shots show the chrome also in the Simple theme. -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.5" />
    <!-- BuilderExtensionsTests check that the host finds UseReactiveUI of this package. -->
    <PackageReference Include="ReactiveUI.Avalonia.Reactive" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- AboutInfoTests compares the launcher version with the MinVer version. The source archive has no MinVer version. -->
  <Target Name="AddMinVerVersionMetadata" DependsOnTargets="MinVer" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <ExpectedMinVerVersion>$(MinVerVersion)</ExpectedMinVerVersion>
      <ExpectedMinVerVersion Condition="'$(MinVerSkip)' == 'true'">$(Version)</ExpectedMinVerVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="MinVerVersion" Value="$(ExpectedMinVerVersion)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AxView\AxView.csproj" />
    <!-- Both assemblies compile the host protocol. The alias prevents duplicate type names. -->
    <ProjectReference Include="..\..\src\AxView.Host12\AxView.Host12.csproj" Aliases="host" />
  </ItemGroup>

</Project>
